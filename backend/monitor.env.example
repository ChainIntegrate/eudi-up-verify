# Monitor configuration (copy to monitor.env, git-ignored). UCL-22: no private keys here;
# the monitor reads only what it checks. Used by deploy/systemd/up-cie-link-monitor.service.
NETWORK=luksoTestnet
RPC_URL=https://rpc.testnet.lukso.network
# same PORT and DB_PATH as backend/.env (the database is opened read-only)
PORT=
DB_PATH=
BACKUP_DIR=
# attester ADDRESS (not the key): compared with the contract and checked for balance
ATTESTER_ADDRESS=0x8F42E3A2a23DE54a8DFa94502f344Cb81062723a
# MIN_ATTESTER_BALANCE=1
# DIGEST_HOUR_UTC=6
# MONITOR_STATE_FILE=
# TRUST_DIR=

# e-mail (same account as backend/.env)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=
