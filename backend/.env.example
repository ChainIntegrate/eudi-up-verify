# Copy to .env (git-ignored) and fill in. Real environment variables take precedence over this file.

# luksoTestnet | luksoMainnet  (contract address and DEPLOY_BLOCK are read from contracts/deployments/<NETWORK>.json)
NETWORK=luksoTestnet
# RPC endpoint (never exposed to the browser, never logged: on mainnet the API key is in the URL path)
#  - testnet: public LUKSO RPC
#  - mainnet: ChainIntegrate self-hosted node with an API key DEDICATED to this service (one key per service)
RPC_URL=https://rpc.testnet.lukso.network
# RPC_URL=https://rpc.chainintegrate.it/rpc/<api-key-dedicated-to-up-cie-link>
# Internal port: check free ports on the server with `sudo ss -ltnp` (3014 is taken by traceability-registry).
# The backend binds to 127.0.0.1 only.
PORT=
# Public origin of the frontend (CORS) and origin written in the statements
PUBLIC_ORIGIN=https://up-cie-link.chainintegrate.it
# SQLite database path (outside the repository), e.g. /var/lib/up-cie-link/up-cie-link.db
DB_PATH=

# Optional (defaults shown)
# UP_SIGNATURE_WINDOW_SEC=300
# STATEMENT_TTL_SEC=900
# Accept CieSign .p7m uploads (tests/demo); set to false once the Android app is in use
ALLOW_CADES_UPLOAD=true

# --- secrets (keep a copy OUTSIDE the server: without them backups are useless) ---
# Private key of the contract's attester (the backend refuses to start if it does not match the contract)
ATTESTER_PRIVATE_KEY=
# 32 random bytes, hex (openssl rand -hex 32). Losing it = uniqueness lost for every stored person.
UNIQ_PEPPER=
# 32 random bytes, hex (openssl rand -hex 32). Losing it = revocation recheck impossible.
CERT_REF_KEY=

# --- CIE trust ---
# SHA-256 fingerprint(s) of the pinned "National root CA for the Italian Electronic Identity Card", comma separated
CIE_ROOT_SHA256=
# Directory with the CA certificates (default: backend/trust)
# TRUST_DIR=
