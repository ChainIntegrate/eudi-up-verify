# /etc/up-cie-link/signer.env — owner root, mode 600 (systemd reads it and passes it to the signer).
# The three secrets are MOVED here from backend/.env (the backend refuses to start if they are still there).
ATTESTER_PRIVATE_KEY=
UNIQ_PEPPER=
CERT_REF_KEY=
# The contract the signer may sign for, and its chain (4201 testnet, 42 mainnet): change both at a redeploy
SIGNER_CONTRACT=
SIGNER_CHAIN_ID=4201
# Rate limits (audit UCL-08, decisions S1 of 2026-10-27). Above them the signer refuses and the owner gets an e-mail.
# SIGNER_MAX_ATTEST_PER_HOUR=20
# SIGNER_MAX_ATTEST_PER_DAY=100
# SIGNER_MAX_INVALIDATE_PER_HOUR=100
# SIGNER_MAX_PERSON_KEYS_PER_MINUTE=30
# SIGNER_MAX_DECRYPT_PER_DAY=2000
# Caps on what a signed transaction may cost
# SIGNER_MAX_GAS=1000000
# SIGNER_MAX_FEE_GWEI=100
