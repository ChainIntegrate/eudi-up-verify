# Hourly monitor (read-only): see backend/src/monitor.js. Started by up-cie-link-monitor.timer.
# Configuration: backend/monitor.env (from monitor.env.example; no private keys), never backend/.env.
# Values agreed on 2026-10-15: see docs/operations.md.
[Unit]
Description=up-cie-link monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=up-cie-link
WorkingDirectory=/var/www/up-cie-link/backend
ExecStart=/usr/bin/node src/monitor.js
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
