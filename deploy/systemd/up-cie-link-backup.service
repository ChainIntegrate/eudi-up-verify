# Daily encrypted backup: see backend/scripts/backup.js. Started by up-cie-link-backup.timer.
# Same user as the backend (it reads DB_PATH and writes BACKUP_DIR). Values: docs/operations.md.
# On failure the script queues a problem email; the monitor also reports a missing or old backup.
[Unit]
Description=up-cie-link encrypted backup

[Service]
Type=oneshot
User=up-cie-link
WorkingDirectory=/var/www/up-cie-link/backend
ExecStart=/usr/bin/node scripts/backup.js
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
