# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
# Values already set in the environment (e.g. Codespaces secrets) take precedence over this file.

# RPC endpoints dedicated to this service
LUKSO_TESTNET_RPC_URL=https://rpc.testnet.lukso.network
# mainnet: ChainIntegrate self-hosted node, with an API key dedicated to deployments (never reuse the backend's key)
LUKSO_MAINNET_RPC_URL=https://rpc.chainintegrate.it/rpc/<api-key-dedicated-to-deploy>

# Key that ONLY pays deployment gas (no role in the contract). Generate one with: npm run new-key
DEPLOYER_PRIVATE_KEY=

# ADDRESS (not the private key) of the backend operational key that will mint badges
ATTESTER=

# Optional: override the owner UP configured in scripts/networks.ts
# OWNER_UP=

# Safety switches (leave commented; set them on the command line when needed)
# CONFIRM_MAINNET=yes
# REDEPLOY=yes
